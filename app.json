{
  "expo": {
    "name": "Gymnix",
    "slug": "fitnessapp",
    "version": "1.0.0",
    "scheme": "fitnessapp",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.tyrekeyazzie.fitnessapp",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.tyrekeyazzie.fitnessapp",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png",
        "backgroundColor": "#f7f3e9"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to use your camera to take a profile photo or a photo of your workout.",
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos so you can choose a profile photo or attach one to a workout.",
          "microphonePermission": false
        }
      ],
      [
        "@sentry/react-native",
        {
          "url": "https://sentry.io/",
          "organization": "gymnix",
          "project": "react-native"
        }
      ],
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#f7f3e9",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#1b1815"
          }
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "33080e7b-194e-4f5f-bb70-aa407ad9fce1"
      }
    },
    "owner": "littlechief",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/33080e7b-194e-4f5f-bb70-aa407ad9fce1"
    }
  }
}
