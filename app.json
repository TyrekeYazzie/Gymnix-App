{
  "expo": {
    "name": "FitnessApp",
    "slug": "fitnessapp",
    "version": "1.0.0",
    "scheme": "fitnessapp",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.tyrekeyazzie.fitnessapp"
    },
    "android": {
      "package": "com.tyrekeyazzie.fitnessapp",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0a0a"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to use your camera to take a profile photo or a photo of your workout.",
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos so you can choose a profile photo or attach one to a workout.",
          "microphonePermission": false
        }
      ],
      "@sentry/react-native",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0a0a0a"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "33080e7b-194e-4f5f-bb70-aa407ad9fce1"
      }
    },
    "owner": "littlechief"
  }
}
