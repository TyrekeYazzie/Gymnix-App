{
  "expo": {
    "name": "FitnessApp",
    "slug": "fitnessapp",
    "version": "1.0.0",
    "scheme": "fitnessapp",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a0a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tyrekeyazzie.fitnessapp"
    },
    "android": {
      "package": "com.tyrekeyazzie.fitnessapp",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0a0a"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow FitnessApp to access your camera to take a photo of your gym session.",
          "photosPermission": "Allow FitnessApp to access your photos to attach one to a workout.",
          "microphonePermission": false
        }
      ],
      "@sentry/react-native"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "33080e7b-194e-4f5f-bb70-aa407ad9fce1"
      }
    },
    "owner": "littlechief"
  }
}
