# Copy this file to .env and fill in real values. .env is gitignored.

# Required — from your Supabase project settings (Project Settings > API).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional — crash reporting (see src/lib/sentry.ts). Leave blank to run
# without Sentry; nothing else in the app depends on this being set.
EXPO_PUBLIC_SENTRY_DSN=
